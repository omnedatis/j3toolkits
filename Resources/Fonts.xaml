<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:res="clr-namespace:wzd32.Resources"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">


    <!--  Font Sizes  -->
    <sys:Double x:Key="FontSizeTitle">24</sys:Double>
    <sys:Double x:Key="FontSizeSubtitle">20</sys:Double>
    <sys:Double x:Key="FontSizeBody">14</sys:Double>
    <sys:Double x:Key="FontSizeCaption">12</sys:Double>

    <!--  Font Families  -->
    <FontFamily x:Key="FontDefault">Microsoft Jhenghe,Segoe UI Varaible</FontFamily>
    <FontFamily x:Key="FontMonospace">Consolas</FontFamily>
    <FontFamily x:Key="FontEmoji">Segoe UI Emoji</FontFamily>


</ResourceDictionary>
