<Window
    x:Class="wzd32.Controls.UserInfoDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:wzd32.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="模擬器資料設定"
    Width="300"
    Height="180"
    mc:Ignorable="d">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/wzd32;component/Resources/Dictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="FontFamily" Value="{StaticResource FontDefault}" />
                <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
                <Setter Property="FontWeight" Value="Regular" />
                <Setter Property="Margin" Value="5,0,0,0" />

            </Style>
            <Style TargetType="TextBox">
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FontFamily" Value="{StaticResource FontDefault}" />
                <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
                <Setter Property="FontWeight" Value="Regular" />
                <Setter Property="Width" Value="200" />
                <Setter Property="Height" Value="20" />
            </Style>
            <Style TargetType="Button">
                <Setter Property="Background" Value="{StaticResource ControlBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource ControlBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="FontFamily" Value="{StaticResource FontDefault}" />
                <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
                <Setter Property="FontWeight" Value="Regular" />

                <Setter Property="MaxHeight" Value="60" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Background="{StaticResource ControlBrush}" ClipToBounds="False">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />

        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock
            Grid.Row="1"
            MaxHeight="20"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Text="模擬器名稱 :" />
        <TextBox
            x:Name="NameTextBox"
            Grid.Row="1"
            Grid.Column="2"
            Grid.ColumnSpan="1"
            Height="20"
            VerticalAlignment="Center"
            Foreground="{StaticResource FormBrush}"
            Text=""
            TextChanged="NameTextBox_TextChanged" />
        <TextBlock
            Grid.Row="2"
            Grid.Column="0"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Text="帳號 :" />
        <TextBox
            x:Name="AccountTextBox"
            Grid.Row="2"
            Grid.Column="2"
            Grid.ColumnSpan="1"
            VerticalAlignment="Center"
            d:Text=""
            Foreground="{StaticResource FormBrush}"
            TextChanged="AccountTextBox_TextChanged" />
        <TextBlock
            Grid.Row="3"
            Grid.Column="0"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Text="密碼 :" />
        <TextBox
            x:Name="PasswordTextBox"
            Grid.Row="3"
            Grid.Column="2"
            Grid.ColumnSpan="1"
            Height="20"
            VerticalAlignment="Center"
            ClipToBounds="False"
            Foreground="{StaticResource FormBrush}"
            Text=""
            TextChanged="PasswordTextBox_TextChanged" />
        <StackPanel
            Grid.Row="4"
            Grid.Column="0"
            Grid.ColumnSpan="4"
            Panel.ZIndex="0"
            FlowDirection="RightToLeft"
            Orientation="Horizontal">
            <Button
                x:Name="CancelButton"
                MinWidth="80"
                MinHeight="20"
                Margin="2,0"
                VerticalAlignment="Center"
                d:Background="{StaticResource ControlBrush}"
                Click="CancelButton_Click"
                Content="取消" />
            <Button
                x:Name="ConfirmButton"
                MinWidth="80"
                MinHeight="20"
                d:Background="{StaticResource ControlBrush}"
                Click="ConfirmButton_Click"
                Content="確認" />
        </StackPanel>
    </Grid>
</Window>
