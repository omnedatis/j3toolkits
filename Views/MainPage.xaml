<Page
    x:Class="wzd32.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="clr-namespace:wzd32.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:wzd32.ViewModels"
    Title="模擬器精靈"
    MinWidth="800"
    MinHeight="600"
    d:DesignHeight="600"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Page.DataContext>
        <vm:MainViewModel />
    </Page.DataContext>

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/wzd32;component/Resources/Dictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="Control">
                <Setter Property="Background" Value="{StaticResource TransparentBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource TransparentBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="FontFamily" Value="{StaticResource FontDefault}" />
                <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="2,5" />
            </Style>
            <Style BasedOn="{StaticResource {x:Type Control}}" TargetType="Button">
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="MinHeight" Value="30" />
                <Setter Property="MinWidth" Value="50" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                                <ContentPresenter
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>

                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                    </Trigger>
                </Style.Triggers>


            </Style>
            <Style TargetType="Border">
                <Setter Property="CornerRadius" Value="3" />
            </Style>
        </ResourceDictionary>

    </Page.Resources>

    <Grid
        x:Name="MainConvas"
        MinWidth="800"
        MinHeight="600"
        d:ShowGridLines="False"
        Background="{StaticResource ControlBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="60" />
            <RowDefinition Height="480" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100" />
            <ColumnDefinition Width="700" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Image
            x:Name="iconimage"
            Width="Auto"
            Height="Auto"
            MinWidth="40"
            MinHeight="40"
            Margin="0,10,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Panel.ZIndex="10"
            Source="/wzd32;component/Assets/bentlyw.ico"
            UseLayoutRounding="True" />
        <StackPanel
            Grid.Row="2"
            Grid.Column="0"
            Margin="10">
            <!--  this is a gplyh icon(can be ckicke)  -->
            <Button Margin="5">
                <StackPanel>
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource IconFont}"
                        FontSize="14"
                        Foreground="{StaticResource TextBrush}"
                        Text="{StaticResource IconOpenWith}" />

                </StackPanel>
            </Button>
            <Button Margin="5" Content="使用者" />
            <Button
                Margin="5"
                Click="Button_Click"
                Command="{Binding TestCommand, Mode=OneWay}"
                Content="測試" />
        </StackPanel>

        <Grid
            x:Name="PanelConvas"
            Grid.Row="2"
            Grid.Column="1"
            Grid.ColumnSpan="2"
            d:ShowGridLines="False"
            Background="{StaticResource PanelBrush}"
            ClipToBounds="False">
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="600" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel
                Grid.Row="0"
                Grid.Column="0"
                MinWidth="600"
                MaxHeight="90"
                VerticalAlignment="Center"
                ClipToBounds="False"
                FlowDirection="RightToLeft"
                Orientation="Horizontal">
                <ctrl:HintButton
                    Width="50"
                    Height="50"
                    ButtonText="註冊"
                    Command="{Binding RegisterCommand}"
                    HintText="{Binding LastModifyDT}"
                    Loaded="HintButton_Loaded_2"
                    UseLayoutRounding="False" />
                <Button Command="{Binding TestCommand}" Content="執行" />
            </StackPanel>

            <DataGrid
                x:Name="UserInfo"
                Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="1"
                MinWidth="600"
                MinHeight="300"
                Margin="20"
                AutoGenerateColumns="True"
                Background="#FFC7C7C7"
                BorderBrush="#FF383838"
                ClipToBounds="False"
                Foreground="Black"
                GridLinesVisibility="Horizontal"
                HeadersVisibility="Column"
                ItemsSource="{Binding UserInfoList}"
                ScrollViewer.CanContentScroll="False"
                ScrollViewer.VerticalScrollBarVisibility="Visible"
                SelectionChanged="UserInfo_SelectionChanged" />

        </Grid>


    </Grid>

</Page>
